---
import ContentSection from '../components/ContentSection.astro'
import HeroSection from '../components/HeroSection.astro'
import {
  heroText,
  introText,
  approachText,
  aboutText,
  whatToExpectText,
  therapyText,
  sessionsText,
  contactText,
} from '../content/textContent'
import Layout from '../layouts/Layout.astro'
import abstractImgPortHi from '../assets/abstract-img-portrait.webp'
import abstractImgPortLo from '../assets/abstract-img-portrait-lo.webp'
import abstractImgLandHi from '../assets/abstract-img-landscape.webp'
import abstractImgLandLo from '../assets/abstract-img-landscape-lo.webp'
import flowersImgHi from '../assets/flowers-img-hi.webp'
import flowersImgLo from '../assets/flowers-img-lo.webp'
import marbleImgPortHi from '../assets/marble-img-portrait-hi.webp'
import marbleImgPortLo from '../assets/marble-img-portrait-lo.webp'
import marbleImgLandHi from '../assets/marble-img-landscape-hi.webp'
import marbleImgLandLo from '../assets/marble-img-landscape-lo.webp'
import mosaicImgHi from '../assets/mosaic-img-hi.webp'
import mosaicImgLo from '../assets/mosaic-img-lo.webp'
import treesImgHi from '../assets/trees-img-hi.webp'
import treesImgLo from '../assets/trees-img-lo.webp'
import profileImgCrop from '../assets/profile-img-crop.webp'
import ContactSection from '../components/ContactSection.astro'
import AboutSection from '../components/about/AboutSection.astro'
import ContactForm from '../components/ContactForm'
import IntroSection from '../components/IntroSection.astro'
import ApproachSection from '../components/ApproachSection.astro'
import WhatToExpectSection from '../components/what-to-expect/WhatToExpectSection.astro'

//-------
const isDev = import.meta.env.DEV
const imgSrcAbstractPortrait = isDev ? abstractImgPortLo : abstractImgPortHi
const imgSrcAbstractLandscape = isDev ? abstractImgLandLo : abstractImgLandHi
const imgSrcMarblePortrait = isDev ? marbleImgPortLo : marbleImgPortHi
const imgSrcMarbleLandscape = isDev ? marbleImgLandLo : marbleImgLandHi
const mosaicImg = isDev ? mosaicImgLo : mosaicImgHi
const flowersImg = isDev ? flowersImgLo : flowersImgHi

const treesImg = isDev ? treesImgLo : treesImgHi
---

<!-- index.astro -->
<Layout title="">
  <HeroSection
    id="home"
    imgSrcPortrait={imgSrcAbstractPortrait}
    imgSrcLandscape={imgSrcAbstractLandscape}
    bottomFadeColour="text-bg-1"
    {...heroText}
  />

  <!-- Ready to be integrated later -->
  <IntroSection id="intro" background="bg-main-beige" bgImgSrcLandscape={imgSrcAbstractLandscape} bgImgSrcPortrait={imgSrcAbstractPortrait} {...introText} />

  <!-- Ready to be integrated later -->
  <ApproachSection
    id="approach"
    bgImgSrc={mosaicImg}
    profileImgSrc={profileImgCrop}
    {...approachText}
  />

  <!-- Note: update children of this component to integrate new changes -->
  <AboutSection
    id="about"
    imgSrc={profileImgCrop}
    bgSrc={mosaicImg}
    text={aboutText}
    background="bg-text-bg-1"
  />

  <WhatToExpectSection
    id="what-to-expect"
    text={whatToExpectText}
    bgImgSrc={flowersImg}
  />

  <!-- Therapy Section -->
  <!-- <ContentSection
    id="therapy"
    heading={therapyText.heading}
    paras={therapyText.paras}
    bgColour="bg-text-bg-2"
    triangleColour="bg-theme-green"
    triangleLeft={false}
    textColour="text-theme-green-dark"
    imgSrc={flowersImg}
    imgAlt="An image of dried flowers."
    imageLeft={false}
    arrowDest="#sessions"
  /> -->

  <!-- Sessions Section -->
  <!-- <ContentSection
    id="sessions"
    heading={sessionsText.heading}
    paras={sessionsText.paras}
    imgSrc={treesImg}
    imgAlt="An image of trees."
    bgColour="bg-text-bg-1"
    triangleColour="bg-text-bg-3"
    triangleLeft={true}
    textColour="text-theme-green-dark"
    arrowDest="#contact"
  /> -->

  <ContactSection
    id="contact"
    imageSrcPortrait={imgSrcMarblePortrait}
    imageSrcLandscape={imgSrcMarbleLandscape}
  >
    <ContactForm client:load />
  </ContactSection>

  <!-- <ToastTester client:load /> -->
</Layout>
