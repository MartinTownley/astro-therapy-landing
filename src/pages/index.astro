---
import ContentCard from '../components/ContentCard.astro'
import ContentSection from '../components/ContentSection.astro'
import H1 from '../components/H1.astro'
import HeroSection from '../components/HeroSection.astro'
import HeroCard from '../components/HeroCard.astro'
import {
  heroText,
  introText,
  aboutText,
  therapyText,
  sessionsText,
  contactText,
} from '../content/textContent'
import IntroSection from '../components/IntroSection.astro'
import TextAndImage from '../components/TextAndImage.astro'
import Welcome from '../components/Welcome.astro'
import Layout from '../layouts/Layout.astro'
import abstractImgPortHi from '../assets/abstract-img-portrait.png'
import abstractImgPortLo from '../assets/abstract-img-portrait-lo.png'
import abstractImgLandHi from '../assets/abstract-img-landscape.png'
import abstractImgLandLo from '../assets/abstract-img-landscape-lo.png'
import flowersImgHi from '../assets/flowers-img-hi.png'
import flowersImgLo from '../assets/flowers-img-lo.png'
import marbleImgPortHi from '../assets/marble-img-portrait-hi.png'
import marbleImgPortLo from '../assets/marble-img-portrait-lo.png'
import marbleImgLandHi from '../assets/marble-img-landscape-hi.png'
import marbleImgLandLo from '../assets/marble-img-landscape-lo.png'
import mosaicImgHi from '../assets/mosaic-img-hi.png'
import mosaicImgLo from '../assets/mosaic-img-lo.png'
import treesImgHi from '../assets/trees-img-hi.png'
import treesImgLo from '../assets/trees-img-lo.png'
import woodpathImg from '../assets/woodpath-img.png'
// import ukcpLogoWhiteBG from '../assets/ukcp_master_logo.png';
// import ukcpLogoTransBG from '../assets/ukcp-black-trans.png'
import profileImg from '../assets/profile-img.jpg'
import profileImgCrop from '../assets/profile-img-crop.jpg'

import ContactSection from '../components/ContactSection.astro'
import ContactCard from '../components/ContactCard.astro'
import Footer from '../components/Footer.astro'

import HeadingWImage from '../components/HeadingWImage.astro'
import AboutSection from '../components/AboutSection.astro'
import ContactForm from '../components/ContactForm'

//-------
const isDev = import.meta.env.DEV
const imgSrcAbstractPortrait = isDev ? abstractImgPortLo : abstractImgPortHi
const imgSrcAbstractLandscape = isDev ? abstractImgLandLo : abstractImgLandHi
const imgSrcMarblePortrait = isDev ? marbleImgPortLo : marbleImgPortHi
const imgSrcMarbleLandscape = isDev ? marbleImgLandLo : marbleImgLandHi
const mosaicImg = isDev ? mosaicImgLo : mosaicImgHi
const flowersImg = isDev ? flowersImgLo : flowersImgHi

const treesImg = isDev ? treesImgLo : treesImgHi
---

<!-- index.astro -->
<Layout title="">
  <HeroSection
    id="home"
    imgSrcPortrait={imgSrcAbstractPortrait}
    imgSrcLandscape={imgSrcAbstractLandscape}
    bottomFadeColour="text-bg-1"
    {...heroText}
  />

  <!-- About (small screen) -->
  <!-- <div class="lg:hidden">
    <AboutSection id="about" imgSrc={profileImgCrop} {...aboutText} />
  </div> -->

  <!-- About (lg screen) -->
  <!-- <div class="hidden lg:block">
    <TextAndImage
      id="about"
      bgSrc={mosaicImg}
      background="bg-text-bg-1"
      imageLeft={true}
      {...aboutText}
    />
  </div> -->

  <AboutSection
    id="about"
    imgSrc={profileImgCrop}
    bgSrc={mosaicImg}
    {...aboutText}
    background="bg-text-bg-1"
  />

  <!-- Therapy Section -->
  <ContentSection
    id="therapy"
    heading={therapyText.heading}
    paras={therapyText.paras}
    bgColour="bg-text-bg-2"
    triangleColour="bg-theme-green"
    triangleLeft={false}
    textColour="text-black"
    imgSrc={flowersImg}
    imgAlt="An image of dried flowers."
    imageLeft={false}
  />

  <!-- Sessions Section -->
  <ContentSection
    id="sessions"
    heading={sessionsText.heading}
    paras={sessionsText.paras}
    imgSrc={treesImg}
    imgAlt="An image of trees."
    bgColour="bg-text-bg-1"
    triangleColour="bg-text-bg-3"
    triangleLeft={true}
    textColour="text-black"
  />

  <ContactSection
    id="contact"
    imageSrcPortrait={imgSrcMarblePortrait}
    imageSrcLandscape={imgSrcMarbleLandscape}
  >
    <!-- <ContactCard {...contactText} /> -->
    <ContactForm client:load />
  </ContactSection>
</Layout>
