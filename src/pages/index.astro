---
import ContentCard from '../components/ContentCard.astro'
import ContentSection from '../components/ContentSection.astro'
import H1 from '../components/H1.astro'
import HeroSection from '../components/HeroSection.astro'
import HeroCard from '../components/HeroCard.astro'
import {
  heroText,
  introText,
  aboutText,
  therapyText,
  sessionsText,
  contactText,
} from '../content/textContent'
import IntroSection from '../components/IntroSection.astro'
import Welcome from '../components/Welcome.astro'
import Layout from '../layouts/Layout.astro'
import abstractImgPortHi from '../assets/abstract-img-portrait.png'
import abstractImgPortLo from '../assets/abstract-img-portrait-lo.png'
import abstractImgLandHi from '../assets/abstract-img-landscape.png'
import abstractImgLandLo from '../assets/abstract-img-landscape-lo.png'
import chairPlantsImg from '../assets/chair-plants-img.png'
import couchImg from '../assets/couch-img.png'
import flowersImg from '../assets/flowers-img.png'
import marbleImgHi from '../assets/marble-img-hi.png'
import marbleImgLo from '../assets/marble-img-lo.png'
import mosaicImg from '../assets/mosaic-img.png'
import treesImg from '../assets/trees-img.png'
import woodpathImg from '../assets/woodpath-img.png'
// import ukcpLogoWhiteBG from '../assets/ukcp_master_logo.png';
// import ukcpLogoTransBG from '../assets/ukcp-black-trans.png'
import FPContentSection from '../components/FPContentSection.astro'
import ContactSection from '../components/ContactSection.astro'
import ContactCard from '../components/ContactCard.astro'
import Footer from '../components/Footer.astro'

const isDev = import.meta.env.DEV
const imgSrcAbstractPortrait = isDev ? abstractImgPortLo : abstractImgPortHi
const imgSrcAbstractLandscape = isDev ? abstractImgLandLo : abstractImgLandHi

const imgSrcMarble = isDev ? marbleImgHi : marbleImgLo
---

<Layout title="">
  <!-- snap scroll -->
  <HeroSection
    id="hero"
    imgSrcPortrait={imgSrcAbstractPortrait}
    imgSrcLandscape={imgSrcAbstractLandscape}
  >
    <HeroCard {...heroText} />
  </HeroSection>
  <div class="h-screen overflow-y-scroll snap-y snap-mandatory">
    <FPContentSection
      id="about-me"
      background="bg-[var(--color-text-bg-1)]"
      {...aboutText}
    />

    <FPContentSection
      id="therapy"
      background="bg-[var(--color-text-bg-2)]"
      {...therapyText}
    />

    <FPContentSection
      id="sessions"
      background="bg-[var(--color-text-bg-1)]"
      {...sessionsText}
    />

    <ContactSection id="contact" imageSrc={imgSrcMarble}>
      <ContactCard {...contactText} />
    </ContactSection>
  </div>

  <!-- <Footer logoSrc={ukcpLogoWhiteBG} logoAlt="UKCP Logo" /> -->

  <!-- <IntroSection /> -->

  <!-- <ContentSection id="About Me" background="bg-[var(--color-bg-1)]" imageSrc={mosaicImg} imageAlt="hi">
		<ContentCard {...aboutText} />
	 </ContentSection>

	 <ContentSection id="Therapy" background="bg-[var(--color-bg-2)]" imageSrc={abstractImg} imageAlt="">
		<ContentCard {...therapyText} />
	 </ContentSection>

	 <ContentSection id="Sessions" background="bg-[var(--color-bg-1)]" imageSrc={marbleImg} imageAlt="">
		<ContentCard {...sessionsText} />
	 </ContentSection> -->
</Layout>
