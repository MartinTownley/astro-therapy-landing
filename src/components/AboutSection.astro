---
import { Image } from 'astro:assets'
// const { id, heading, paras, imgSrc } = Astro.props
import AboutMobile from './AboutMobile.astro'
import AboutDesktop from './AboutDesktop.astro'
import TextAndImage from './TextAndImage.astro'

// destructure id, forward rest
const { id, imgSrc, background, imageLeft, heading, paras, bgSrc } = Astro.props
const aboutText = { heading, paras }
---

<section id={id}>
  <!-- Mobile -->
  <div class="lg:hidden">
    <AboutMobile imgSrc={imgSrc} aboutText={aboutText} />
  </div>

  <!-- Desktop -->
  <div class="hidden lg:block">
    <TextAndImage
      bgSrc={bgSrc}
      background={background}
      imageLeft={true}
      heading={heading}
      paras={paras}
    />
  </div>
</section>
