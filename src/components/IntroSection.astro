---
import { introText } from '../content/textContent'
import { ChevronDownIcon } from '@heroicons/react/16/solid'
import { Image } from 'astro:assets'
const { id, bgImgSrcLandscape, bgImgSrcPortrait } = Astro.props
---

<section
  id={id}
  class="relative flex flex-col items-center pt-16 md:pt-24 px-4 overflow-hidden"
>
  <!-- Background images -->
  <Image
    src={bgImgSrcPortrait}
    alt=""
    loading="lazy"
    layout="full-width"
    class="intro-bg-image absolute inset-0 -top-50 w-full h-full object-cover block lg:hidden scale-200"
  />
  <Image
    src={bgImgSrcLandscape}
    alt=""
    loading="lazy"
    layout="full-width"
    class="intro-bg-image absolute inset-0 -top-50 w-full h-full object-cover hidden lg:block scale-200"
  />
  <!-- Beige overlay -->
  <div class="absolute inset-0 bg-main-beige/85 backdrop-blur-xs"></div>

  <div class="relative z-10 max-w-prose">
    <h1
      class="fade-up text-center text-3xl sm:text-4xl md:text-5xl font-light mb-6 text-theme-green-dark"
    >
      <span class="text-theme-green-dark">
        {introText.heading.primary}
      </span>{' '}
      <span class="text-theme-green-dark">
        {introText.heading.secondary}
      </span>
    </h1>
    <hr
      class="fade-up mb-6 text-theme-pink/40"
      style="transition-delay: 100ms"
    />

    {
      introText.paras.map((para, i) => (
        <p
          class="fade-up text-lg md:text-xl leading-relaxed text-theme-green-dark mb-4"
          style={`transition-delay: ${(i + 2) * 100}ms`}
        >
          {para}
        </p>
      ))
    }
  </div>
  <div
    class="fade-up relative z-10 flex justify-center mt-4"
    style="transition-delay: 400ms"
  >
    <a href="#approach" class="cursor-pointer">
      <ChevronDownIcon
        className="h-24 text-theme-green-light opacity-40 hover:opacity-60 transition-opacity"
      />
    </a>
  </div>
</section>
