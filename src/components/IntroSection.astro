---
import { introText } from '../content/textContent'
import { ChevronDownIcon } from '@heroicons/react/16/solid'
const { id, background } = Astro.props
---

<section
  id={id}
  class=`flex flex-col items-center pt-16 md:pt-24 px-4 ${background}`
>
  <div class="max-w-prose">
    <h1
      class="fade-up text-3xl text-center md:text-4xl font-semibold mb-6 text-theme-green-dark"
    >
      <span class="text-theme-green-dark">
        {introText.heading.primary}
      </span>{' '}
      <span class="text-theme-green-dark">
        {introText.heading.secondary}
      </span>
    </h1>
    <hr class="fade-up mb-6 text-theme-pink/40" style="transition-delay: 100ms" />

    {
      introText.paras.map((para, i) => (
        <p
          class="fade-up text-lg md:text-2xl leading-relaxed text-gray-700 mb-4"
          style={`transition-delay: ${(i + 2) * 100}ms`}
        >
          {para}
        </p>
      ))
    }
  </div>
  <div class="fade-up flex justify-center mt-4" style="transition-delay: 400ms">
    <a href="#approach" class="cursor-pointer">
      <ChevronDownIcon
        className="h-24 text-theme-green-light opacity-40 hover:opacity-60 transition-opacity"
      />
    </a>
  </div>
</section>
