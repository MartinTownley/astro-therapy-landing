---
import { introText } from '../content/textContent'
import { ChevronDownIcon } from '@heroicons/react/16/solid'
const { id, background } = Astro.props
---

<section
  id={id}
  class=`flex flex-col items-center pt-16 md:pt-24 px-4 ${background}`
>
  <div class="max-w-prose">
    <h1
      class="text-3xl text-center md:text-4xl font-semibold mb-6 text-theme-green-dark"
    >
      {introText.heading}
    </h1>
    <hr class="mb-6 text-theme-pink/40" />

    {
      introText.paras.map((para) => (
        <p class="text-lg md:text-2xl leading-relaxed text-gray-700 mb-4">
          {para}
        </p>
      ))
    }
  </div>
  <div class="flex justify-center mt-4">
    <ChevronDownIcon
      className="h-24 text-theme-green-light opacity-40 hover:opacity-60"
    />
  </div>
</section>
