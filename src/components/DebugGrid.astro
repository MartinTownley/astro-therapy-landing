---
interface Props {
  cols?: 12 | 6 | 4
  gap?: 0 | 2 | 4 | 6 | 8
}

const { cols = 12, gap = 4 } = Astro.props as Props

const colClass = {
  12: 'grid-cols-12',
  6: 'grid-cols-6',
  4: 'grid-cols-4',
}[cols]

const gapClass = {
  0: 'gap-0',
  2: 'gap-2',
  4: 'gap-4',
  6: 'gap-6',
  8: 'gap-8',
}[gap]
---

<div
  class={`pointer-events-none fixed inset-0 z-50 grid grid-cols-4 sm:grid-cols-6 md:grid-cols-12 gap-2 sm:gap-4 md:gap-6 px-4 sm:px-4 md:px-0`}
>
  {Array.from({ length: 12 }).map((_, i) => <div class="bg-red-500/20" />)}
</div>
