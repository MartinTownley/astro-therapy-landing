---
interface Props {
  cols?: 12 | 6 | 4
  gap?: 0 | 2 | 4 | 6 | 8
}

const { cols = 12, gap = 4 } = Astro.props as Props

const colClass = {
  12: 'grid-cols-12',
  6: 'grid-cols-6',
  4: 'grid-cols-4',
}[cols]

const gapClass = {
  0: 'gap-0',
  2: 'gap-2',
  4: 'gap-4',
  6: 'gap-6',
  8: 'gap-8',
}[gap]
---

<div
  class={`pointer-events-none fixed inset-0 z-50 grid ${colClass} ${gapClass}`}
>
  {Array.from({ length: cols }).map((_, i) => <div class="bg-red-500/10" />)}
</div>
