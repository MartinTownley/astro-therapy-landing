---
import Picture from 'astro/components/Picture.astro'
import { Image } from 'astro:assets'

const { id, imageSrcPortrait, imageSrcLandscape, imageAlt = '' } = Astro.props
---

<section
  id={id}
  class="relative min-h-screen snap-start flex items-center justify-center"
>
  <div class="absolute inset-0 z-0">
    <Picture
      src={imageSrcPortrait}
      formats={['avif', 'webp']}
      alt="A marbled image."
      loading="lazy"
      class="w-full h-full object-cover"
    />
  </div>

  <!-- top fade -->
  <div
    class="absolute inset-x-0 top-0 h-32 bg-gradient-to-b from-bg-1 via-transparent to-transparent filter blur-lg"
  >
  </div>
  <div class="absolute inset-0 z-0 bg-white/30"></div>

  <!-- bottom fade -->
  <div
    class="absolute inset-x-0 bottom-0 h-96 bg-gradient-to-t from-white via-transparent to-transparent filter blur-lg"
  >
  </div>

  <!-- Foreground content -->
  <div
    class="relative z-10 w-full sm:max-w-lg lg:max-w-2xl mx-auto drop-shadow-xl/50 px-2 md:py-6"
  >
    <slot />
  </div>
</section>
