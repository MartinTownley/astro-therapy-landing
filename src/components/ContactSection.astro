---
import Picture from 'astro/components/Picture.astro'
import { Image } from 'astro:assets'

const { id, imageSrc, imageAlt = '' } = Astro.props
---

<section
  id={id}
  class="relative h-screen snap-start flex items-center justify-center"
>
  <!-- <div class="absolute inset-0 z-0">
    <Image
      src={imageSrc}
      alt=""
      loading="lazy"
      quality="max"
      class="w-full h-full object-cover"
    />
  </div> -->

  <div class="absolute inset-0 z-0">
    <Picture
      src={imageSrc}
      formats={['avif', 'webp']}
      alt="A marbled image."
      loading="lazy"
      class="w-full h-full object-cover"
    />
  </div>

  <div class="absolute inset-0 z-0 bg-white/30"></div>
  <div
    class="absolute inset-x-0 bottom-0 h-96 bg-gradient-to-t from-white via-transparent to-transparent filter blur-lg"
  >
  </div>

  <div class="relative z-10 w-full max-w-md sm:max-w-2xl mx-auto px-4 sm:px-6">
    <slot />
  </div>
</section>
