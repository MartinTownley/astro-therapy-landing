---
import { Image } from "astro:assets";

const {
    id,
    imageSrc,
    imageAlt = '',
} = Astro.props;
---

<section id={id} class="relative min-h-screen flex items-center justify-center px-4 py-16 sm:px-6">
    
    <div class="absolute inset-0 z-0">
        <Image src={imageSrc} alt="" loading="eager" quality="max" class="w-full h-full object-cover opacity-80"/>
    </div>

    <div class="relative z-10 w-full">
        <slot />
    </div>
</section>
