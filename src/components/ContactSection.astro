---
import Picture from 'astro/components/Picture.astro'
import { Image } from 'astro:assets'

const { id, imageSrcPortrait, imageSrcLandscape, imageAlt = '' } = Astro.props
---

<section
  id={id}
  class="relative scroll-mt-16 min-h-[calc(100vh-65px)] snap-start flex items-center justify-center bg-theme-pink/60"
>
  <!-- Background image, hidden on small screens -->
  <div class="absolute inset-0 z-0 hidden md:block">
    <Picture
      src={imageSrcPortrait}
      formats={['avif', 'webp']}
      alt="A marbled image."
      loading="lazy"
      class="w-full h-full object-cover"
    />
    <div class="absolute inset-0 bg-white/30"></div>
  </div>

  <!-- Mobile fallback background -->
  <div class="absolute inset-0 z-0 bg-theme-pink/50 md:hidden"></div>

  <!-- Foreground content -->
  <div
    class="relative z-10 w-full mx-auto px-0 md:max-w-lg lg:max-w-2xl md:drop-shadow-2xl/50 md:py-6"
  >
    <slot />
  </div>
</section>
