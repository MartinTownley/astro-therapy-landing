---
import Picture from 'astro/components/Picture.astro'
const { id, imageSrcPortrait, imageSrcLandscape, imageAlt = '' } = Astro.props
---

<section
  id={id}
  class="relative min-h-screen snap-start flex items-center justify-center bg-theme-pink/60"
>
  <!-- Background image -->
  <div class="absolute inset-0 z-0">
    <Picture
      src={imageSrcPortrait}
      formats={['avif', 'webp']}
      alt="A marbled image."
      loading="lazy"
      layout="full-width"
      class="w-full h-full object-cover"
    />
    <div class="absolute inset-0 bg-black/40"></div>
  </div>

  <!-- Foreground content -->
  <div class="relative z-10 w-full mx-auto px-0 md:max-w-lg lg:max-w-2xl">
    <slot />
  </div>
</section>
