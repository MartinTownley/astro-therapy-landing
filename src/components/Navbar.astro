---
import { Icon } from 'astro-icon/components'
const { bgColour } = Astro.props
const navLinks = [
  {
    name: 'Home',
    url: '/',
  },
  {
    name: 'About',
    url: '#',
  },
  {
    name: 'Therapy',
    url: '#',
  },
  {
    name: 'Sessions',
    url: '#',
  },
]
---

<div
  class={`fixed h-50 w-full md:h-20 top-0 z-50 flex justify-start items-center px-6 md:px-12 max-w-screen mx-auto ${bgColour}`}
>
  <div>
    <button id="menu-btn" aria-expanded="false" aria-label="Open mobile nav">
      <Icon name="mdi:menu" width="200" />
    </button>
    <ul
      class="hidden md:flex flex-col md:flex-row space-y-4 md:space-y-0 md:space-x-6"
      id="nav-menu"
    >
      {
        navLinks.map((link) => (
          <li>
            <a href={link.url}>{link.name}</a>
          </li>
        ))
      }
    </ul>
  </div>
</div>

<script>
  const navBtn = document.querySelector('#menu-btn')
  const navMenu = document.querySelector('#nav-menu')

  navBtn?.addEventListener('click', () => {
    const expanded = navBtn.getAttribute('aria-expanded') === 'true'
    navBtn.setAttribute('aria-expanded', String(!expanded))
    navMenu?.classList.toggle('hidden')
  })
</script>
