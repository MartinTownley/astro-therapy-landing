---
const { id, aboutText } = Astro.props
---

<section id={id} class="bg-theme-green text-white py-20 px-10">
  <div class="columns-2 gap-16">
    <h2
      class="inline-block bg-white text-theme-green-dark text-3xl font-semibold px-6 py-2 mb-8 border-black border-b-2 border-r-2 [column-span:all]"
    >
      {aboutText.heading}
    </h2>
    {
      aboutText.paras.map((p: string) => (
        <p class="mb-6 text-lg leading-relaxed">{p}</p>
      ))
    }
  </div>
</section>
