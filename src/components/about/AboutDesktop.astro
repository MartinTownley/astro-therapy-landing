---
const { id, text } = Astro.props
---

<section id={id} class="bg-text-bg-2 text-theme-green-dark py-20 px-20">
  <div class="max-w-5xl mx-auto">
    <div class="columns-2 gap-16">
      <h2
        class="inline-block bg-theme-green text-white text-3xl font-semibold px-6 py-2 mb-8 border-black border-b-2 border-r-2 [column-span:all]"
      >
        {text.heading}
      </h2>
      {
        text.paras.map((p: string) => (
          <p class="mb-6 text-lg leading-relaxed">{p}</p>
        ))
      }
    </div>
  </div>
</section>
