---
const { id, text } = Astro.props
---

<section id={id} class="noise relative bg-text-bg-2">
  <div
    class="flex flex-col px-6 content-center max-w-prose mx-auto items-center py-12 space-y-6"
  >
    <div class="space-y-4">
      <h2
        class="fade-up text-2xl font-semibold bg-theme-green text-white block w-fit mx-auto px-4 py-1 border-black border-b-2 border-r-2"
      >
        {text.heading}
      </h2>

      <div class="space-y-4">
        {
          text.paras.map((para: string, i: number) => (
            <p
              class="fade-up leading-relaxed text-lg text-theme-green-dark"
              style={`transition-delay: ${(i + 1) * 100}ms`}
            >
              {para}
            </p>
          ))
        }
      </div>
    </div>
  </div>
</section>
