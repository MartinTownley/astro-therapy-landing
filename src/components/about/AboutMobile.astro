---
const { id, aboutText } = Astro.props
---

<section id={id} class="relative bg-text-bg-2/80">
  <div
    class="flex flex-col px-6 content-center max-w-prose mx-auto items-center py-12 space-y-6 relative z-10"
  >
    <div class="space-y-4">
      <h2
        class="text-2xl text-theme-green font-sans font-semibold bg-text-bg-1 block w-fit mx-auto px-4 border-gray-400 border-b-2 border-r-2"
      >
        {aboutText.heading}
      </h2>

      <div class="space-y-4">
        {
          aboutText.paras.map((para: string) => (
            <p class="leading-relaxed text-lg text-black">{para}</p>
          ))
        }
      </div>
    </div>
  </div>
</section>
