---
import ApproachMobile from './ApproachMobile.astro'
import ApproachDesktop from './ApproachDesktop.astro'
const { id, bgImgSrc, profileImgSrc, heading, paras } = Astro.props
const approachText = { heading, paras }
---

<section id={id} class="relative">
  <!--Mobile -->
  <div class="lg:hidden">
    <ApproachMobile profileImgSrc={profileImgSrc} approachText={approachText} />
  </div>

  <!-- Desktop -->
  <div class="hidden lg:block">
    <ApproachDesktop
      bgImgSrc={bgImgSrc}
      profileImgSrc={profileImgSrc}
      {...approachText}
    />
  </div>
</section>
