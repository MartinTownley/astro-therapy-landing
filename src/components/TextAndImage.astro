---
import { Image } from 'astro:assets'
const {
  id,
  heading,
  paras,
  bgSrc,
  background = '',
  imageLeft = true,
  triangleDirection = 'left',
  triangleColor,
  headingAlign = 'left',
  textColour = 'text-black',
} = Astro.props

const triangleClip =
  triangleDirection === 'left'
    ? 'polygon(0 0, 100% 0, 0 100%)'
    : 'polygon(0 0, 100% 0, 100% 100%)'

headingAlign === 'left' ? 'self-start text-left' : 'self-end text-right'
---

<section
  id={id}
  class={`relative min-h-screen lg:min-h-0  md:min-h-0 flex flex-col justify-center w-full ${background} py-0 `}
>
  <div
    class={`flex flex-col lg:flex-row  items-stretch gap-8 px-0 ${imageLeft ? '' : 'lg:flex-row-reverse'}`}
  >
    <div class="w-full lg:w-1/2 hidden lg:block relative">
      <Image
        src={bgSrc}
        alt="An abstract image."
        loading="lazy"
        class="absolute w-full h-full object-cover"
      />

      <!-- Dark Overlay -->
      <div class="absolute inset-0 bg-black/30"></div>

      <!-- Heading (desktop) positioned in front of the image -->
      <h2
        class="absolute left-1/2 top-1/2 transform -translate-x-1/2 -translate-y-1/2 text-4xl font-semibold text-white text-center z-10 border-b-8 border-white pb-6 backdrop-blur-md px-2 py-2 rounded-md"
      >
        {heading}
      </h2>
    </div>

    {/* Small screen */}
    <div
      class=`w-full lg:w-1/2 px-6 py-12 max-w-prose mx-auto flex flex-col items-start ${textColour}`
    >
      <h2
        class={`lg:hidden text-2xl block w-fit mx-auto px-4 font-signature font-semibold mb-4`}
      >
        {heading}
      </h2>

      <div class=`space-y-0 `>
        {
          paras.map((para: string) => (
            <p class="text-lg lg:text-xl mt-0 py-3 leading-relaxed text-left">
              {para}
            </p>
          ))
        }
      </div>
    </div>
  </div>
</section>
