---
import Image from "astro/components/Image.astro";

const {
  logoSrc,
  logoAlt = "UKCP Logo",
} = Astro.props;
---

<footer class="bg-gray-100 py-2 px-4 sm:px-8">
  <div class="max-w-screen-xl mx-auto flex flex-col sm:flex-row items-end justify-between gap-4">
    
    <Image src={logoSrc} alt={logoAlt} loading="lazy" quality="max" width={80} class="w-auto" />

    <!-- <div class="text-sm text-gray-500 text-center sm:text-right">
      <slot />
    </div> -->

  </div>
</footer>