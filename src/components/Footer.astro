---
import Image from "astro/components/Image.astro";

const {
  logoSrc,
  logoAlt = "UKCP Logo",
} = Astro.props;
---

<footer class="bg-stone-700 py-0 px-0 sm:px-8">
  <div class="max-w-screen-xl mx-auto flex gap-4 justify-center">
    
    <Image src={logoSrc} alt={logoAlt} loading="lazy" quality="max" width={80} class="w-auto" />

    <!-- <div class="text-sm text-gray-500 text-center sm:text-right">
      <slot />
    </div> -->

  </div>
</footer>