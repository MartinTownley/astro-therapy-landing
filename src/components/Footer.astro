---
import Image from 'astro/components/Image.astro'

const { logoSrc, logoAlt = 'UKCP Registered' } = Astro.props
const logoHeight = 24
---

<!-- Footer component -->
<footer class=`-mt-${logoHeight} w-full z-10 py-0 px-4 sm:px-8`>
  <div class="max-w-screen-xl mx-auto flex gap-4 justify-center">
    <Image
      src={logoSrc}
      alt={logoAlt}
      loading="lazy"
      quality=""
      class=`h-${logoHeight} w-auto drop-shadow-xl`
    />
  </div>
</footer>
