---
const {
  id,
  heading,
  paras,
  bgSrc,
  bgColour,
  textColour,
  triangleColour,
  triangleLeft,
} = Astro.props

const triangle = triangleLeft ? 'triangle-left' : 'triangle-right'
---

<section
  id={id}
  class=`relative min-h-screen md:min-h-0 flex flex-col justify-center w-full ${bgColour}`
>
  <div
    class=`absolute top-0 left-0 w-full h-16 ${triangle} ${triangleColour} clip-path-polygon`
  >
  </div>

  <div class="flex flex-col items-stretch gap-8 px-0">
    <div
      class={`w-full px-6 py-12 max-w-prose mx-auto flex flex-col items-start ${textColour}`}
    >
      <h2
        class="text-2xl block w-fit mx-auto px-4 font-sans font-semibold mb-4"
      >
        {heading}
      </h2>

      <div>
        {
          paras.map((para: string) => (
            <p class="text-lg mt-0 py-3 leading-relaxed text-left">{para}</p>
          ))
        }
      </div>
    </div>
  </div>
</section>
