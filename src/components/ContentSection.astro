---
import ContentDesktop from './ContentDesktop.astro'
import ContentMobile from './ContentMobile.astro'

// forward all props (switchboard)
const props = Astro.props
---

<div>
  <!-- Mobile -->
  <div class="lg:hidden">
    <ContentMobile {...props} />
  </div>

  <!-- Desktop -->
  <div class="hidden lg:block">
    <ContentDesktop {...props} />
  </div>
</div>
