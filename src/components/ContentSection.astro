---
import ContentDesktop from './ContentDesktop.astro'
import ContentMobile from './ContentMobile.astro'

// forward all props (switchboard)
const { id, ...rest } = Astro.props
---

<section id={id}>
  <!-- Mobile -->
  <div class="lg:hidden">
    <ContentMobile {...rest} />
  </div>

  <!-- Desktop -->
  <div class="hidden lg:block">
    <ContentDesktop {...rest} />
  </div>
</section>
