---
import { Image } from 'astro:assets'
const { id, aboutText, imgSrc } = Astro.props
---

<section id={id} class="relative bg-text-bg-2/80">
  <!-- Content (photo + heading + text) -->
  <div
    class="flex flex-col px-6 content-center max-w-prose mx-auto items-center py-12 space-y-6 relative z-10"
  >
    <div class="object-cover rounded-xl overflow-hidden shadow-lg">
      <Image
        src={imgSrc}
        alt="Photo of Jade Zelkowicz."
        loading="eager"
        layout="full-width"
        width="350"
        class=""
      />
    </div>

    <div class="space-y-4">
      <h2
        class="text-2xl text-theme-green font-signature font-semibold bg-text-bg-1 block w-fit mx-auto px-4"
      >
        {aboutText.heading}
      </h2>

      <div class="space-y-4">
        {
          aboutText.paras.map((para: string) => (
            <p class="leading-relaxed text-lg text-white">{para}</p>
          ))
        }
      </div>
    </div>
  </div>
  <!-- Colored block rising up behind -->
  <div class="absolute top-64 bottom-0 w-full bg-theme-green-light -z-0"></div>
</section>
