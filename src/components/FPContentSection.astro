---
const { id, background, heading, paras } = Astro.props
---

<!-- FPContentSection.astro -->
<section
  id={id}
  class={`h-screen snap-start flex flex-col justify-center ${background} `}
>
  <div class="overflow-y-auto py-12 px-6 max-w-prose mx-auto">
    <h1 class="text-3xl text-center font-semibold mb-8">{heading}</h1>

    <div class="space-y-0">
      {
        paras.map((para: string) => (
          <p class="text-lg mt-0 py-3 leading-relaxed text-left">{para}</p>
        ))
      }
    </div>
  </div>
</section>
