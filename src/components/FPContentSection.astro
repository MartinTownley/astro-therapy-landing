---
const { id, background, heading, paras } = Astro.props
---

<section
  id={id}
  class={`flex flex-col justify-center min-h-screen ${background} `}
>
  <div class="py-10 px-6 max-w-prose mx-auto">
    <h1 class="text-3xl text-center font-semibold mb-8">{heading}</h1>

    <div class="space-y-0">
      {
        paras.map((para: string) => (
          <p class="text-lg mt-0 py-3 leading-relaxed text-left">{para}</p>
        ))
      }
    </div>
  </div>
</section>
