---
const { id, background, bottomFade, heading, paras } = Astro.props
---

<!-- FPContentSection.astro -->
<section
  id={id}
  class={`relative min-h-screen snap-start flex flex-col justify-center ${background} `}
>
  <div class="py-12 px-6 max-w-prose mx-auto">
    <h1 class="text-3xl text-center font-semibold mb-8">{heading}</h1>
    <div class="space-y-0">
      {
        paras.map((para: string) => (
          <p class="text-lg mt-0 py-3 leading-relaxed text-left">{para}</p>
        ))
      }
    </div>
  </div>

  <!-- bottom fade -->
  <!-- <div
    class={`absolute bottom-0 left-0 w-full h-32 bg-gradient-to-b from-transparent to-text-bg-${bottomFade} z-20 border border-blue-500`}
  >
  </div> -->
</section>
