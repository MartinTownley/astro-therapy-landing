---
const { heading, subheading, button } = Astro.props
---

<div
  class="flex flex-col items-center bg-text-bg-1 py-16 px-6 text-center max-w-full sm:max-w-md mx-auto text-hero-text space-y-8 border border-outline-colour"
>
  <h1 class="text-3xl lg:text-4xl text-hero-text-red font-bold">{heading}</h1>
  <p class="text-base lg:text-2xl">{subheading}</p>
  <a href="#contact">
    <button
      class="px-4 py-2 bg-theme-green text-white font-medium rounded border-b-4 border-theme-green-dark hover:bg-theme-green-light hover:border-theme-green active:translate-y-[2px] active:border-none transition duration-75 lg:text-2xl"
    >
      {button}
    </button>
  </a>
</div>
