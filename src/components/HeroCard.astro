---
const { heading, subheading, button } = Astro.props
---

<div
  class="flex flex-col items-center bg-text-bg-2 py-16 px-6 text-center max-w-full sm:max-w-md mx-auto text-hero-text space-y-8 border border-outline-colour"
>
  <h1 class="text-3xl text-hero-text font-bold">{heading}</h1>
  <p class="text-base">{subheading}</p>
  <a href="#contact">
    <button
      class="px-4 py-2 bg-bg-1 text-white font-medium rounded border-b-4 border-bg-1-dark hover:bg-bg-1-dar hover:border-bg-1-darker active:translate-y-[2px] active:border-b-bg-1 transition duration-75"
    >
      {button}
    </button>
  </a>
</div>
