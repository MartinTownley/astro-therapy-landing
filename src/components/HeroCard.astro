---
const {heading, subheading, button} = Astro.props;
---

<div class="flex flex-col items-center bg-[var(--color-hero-card-bg)] py-10 px-6 text-center max-w-full sm:max-w-md mx-auto text-[var(--color-hero-text)] space-y-4 border border-[var(--color-outline)]">
    <h1 class="text-3xl text-[var(--color-hero-text)] font-bold">{heading}</h1>
    <p class="text-base">{subheading}</p>
    <button class="mt-2 px-4 py-2 bg-[var(--color-bg-1)] text-white rounded hover:bg-gray-100 transition">
      {button}
    </button>
  </div>
  