---
import { Image } from 'astro:assets'

const {
  id,
  background = 'bg-black',
  imgSrcPortrait,
  imgSrcLandscape,
  heading,
  subheading,
  button,
} = Astro.props
---

<main class="relative min-h-screen bg-text-bg-1">
  <!-- Background Image -->
  <div class="absolute inset-0 z-0">
    <!-- Mobile (portrait) -->
    <Image
      src={imgSrcPortrait}
      alt="An abstract image."
      loading="eager"
      layout="full-width"
      class="w-full h-full object-cover block lg:hidden blur-[1px]"
    />

    <!-- Desktop (landscape) -->
    <Image
      src={imgSrcLandscape}
      alt="An abstract image."
      loading="eager"
      layout="full-width"
      class="w-full h-full object-cover hidden lg:block"
    />
  </div>

  <!-- Overlay -->
  <div class="absolute inset-0 bg-black/40"></div>

  <!-- Content Grid -->
  <div
    class="relative z-10 container mx-auto px-4 h-full grid grid-cols-12 items-center"
  >
    <!-- Content -->
    <div
      class="col-span-12 md:col-span-6 lg:col-span-6 lg:col-start-2 md:col-start-1 space-y-8 md:translate-y-20 text-center md:text-left flex flex-col items-center md:items-start text-text-bg-1 [text-shadow:0_4px_8px_rgba(0,0,0,0.7)]"
    >
      <h1
        class="text-4xl sm:text-5xl lg:text-6xl font-bold leading-tight max-w-md"
      >
        {heading}
      </h1>
      <div class="">
        <p
          class="text-lg sm:text-xl lg:text-2xl font-light leading-relaxed max-w-xs sm:max-w-md lg:max-w-lg"
        >
          {subheading}
        </p>
      </div>
      <a href="#contact">
        <button
          class="px-4 py-2 bg-theme-pink-bright text-white font-medium rounded border-b-4
          border-r-3
           border-theme-pink-darker hover:bg-theme-green-light hover:border-theme-green active:translate-y-[2px] active:border-none transition duration-75 lg:text-2xl cursor-pointer"
        >
          {button}
        </button>
      </a>
    </div>
    <!-- <a
      href="#about"
      class="absolute bottom-6 left-1/2 -translate-x-1/2 z-20 cursor-pointer"
    >
      <ArrowDownIcon
        className="h-12 md:h-16 w-12 md:w-16 text-white opacity-80 hover:opacity-100"
      />
    </a> -->
  </div>
</main>
