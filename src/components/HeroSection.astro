---
import Picture from 'astro/components/Picture.astro'
import { Image } from 'astro:assets'

const {
  id,
  background = 'bg-black',
  imgSrcPortrait,
  imgSrcLandscape,
} = Astro.props
---

<main
  id={id}
  class="min-h-[calc(100vh-60px)] relative py-10 flex items-center justify-center px-4 sm:px-6 bg-[var(--color-text-bg-1)]"
>
  <!-- Background Image -->
  <!-- <div class="absolute inset-0 z-0">
      <Image src={imageSrc} alt="" loading="eager" quality="max" class="w-full h-full object-cover opacity-60"/>
    </div> -->

  <div class="absolute inset-0 z-0">
    <!-- Mobile (portrait) -->

    <Picture
      src={imgSrcPortrait}
      formats={['avif', 'webp']}
      alt="An abstract image."
      loading="eager"
      class="w-full h-full object-cover opacity-70 block lg:hidden"
    />

    <!-- Desktop (landscape) -->
    <Picture
      src={imgSrcLandscape}
      formats={['avif', 'webp']}
      alt="An abstract image."
      loading="eager"
      class="w-full h-full object-cover opacity-70 hidden lg:block"
    />
  </div>

  <!-- Foreground content -->
  <div class="relative z-10 w-full">
    <slot />
  </div>
</main>
