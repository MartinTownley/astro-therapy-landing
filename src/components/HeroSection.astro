---
import { Image } from "astro:assets";

const {
   id,
   background = 'bg-black',
   imageSrc,
   imageAlt = '',
} = Astro.props;
---

<main id={id} class="min-h-screen flex items-center justify-center px-4 py-16 sm:px-6 -mt-14 bg-[var(--color-text-bg-1)]">
    <!-- <slot/> -->
    <!-- <img src={bgImg.src} /> -->
     <!-- Background Image -->
    <div class="absolute inset-0 z-0">
      <Image src={imageSrc} alt="" loading="eager" quality="max" class="w-full h-full object-cover opacity-60"/>
    </div>
    

    <!-- Foreground content -->
     <div class="relative z-10 w-full translate-y-16">
        <slot />
     </div>

</main>