---
import { Image } from 'astro:assets'

const {
  id,
  background = 'bg-black',
  imgSrcPortrait,
  imgSrcLandscape,
  bottomFadeColour,
  heading,
  subheading,
  button,
} = Astro.props
---

<main
  id={id}
  class="min-h-screen flex items-center justify-center px-4 sm:px-6 bg-text-bg-1"
>
  <!-- Background Image -->

  <div class="absolute inset-0 z-0">
    <!-- Mobile (portrait) -->

    <Image
      src={imgSrcPortrait}
      alt="An abstract image."
      loading="eager"
      class="w-full h-full object-cover block lg:hidden"
    />

    <!-- Desktop (landscape) -->
    <Image
      src={imgSrcLandscape}
      alt="An abstract image."
      loading="eager"
      class="w-full h-full object-cover hidden lg:block"
    />
  </div>

  <!-- Overlay -->
  <div class="absolute inset-0 bg-black/50"></div>

  <!-- Content -->
  <div class="flex flex-col relative z-10 text-white space-y-8 max-w-2xl">
    <h1 class="text-4xl lg:text-6xl font-bold leading-tight">{heading}</h1>
    <p class="text-lg lg:text-2xl font-medium leading-relaxed">{subheading}</p>
    <a href="#contact">
      <button
        class="px-4 py-2 bg-theme-green text-white font-medium rounded border-b-4 border-theme-green-dark hover:bg-theme-green-light hover:border-theme-green active:translate-y-[2px] active:border-none transition duration-75 lg:text-2xl"
      >
        {button}
      </button>
    </a>
  </div>

  <!-- Foreground content -->
  <div
    class="relative z-10 w-full max-w-md sm:max-w-2xl mx-auto drop-shadow-xl/50"
  >
    <slot />
  </div>
</main>
