---
import Picture from 'astro/components/Picture.astro'
import { Image } from 'astro:assets'

const {
  id,
  background = 'bg-black',
  imgSrcPortrait,
  imgSrcLandscape,
} = Astro.props
---

<main
  id={id}
  class="min-h-[calc(100vh-60px)] py-10 flex items-center justify-center px-4 sm:px-6 bg-[var(--color-text-bg-1)]"
>
  <!-- Background Image -->

  <div class="absolute inset-0 z-0">
    <!-- Mobile (portrait) -->

    <Picture
      src={imgSrcPortrait}
      formats={['avif', 'webp']}
      alt="An abstract image."
      loading="eager"
      class="w-full h-full object-cover block lg:hidden"
    />

    <!-- Desktop (landscape) -->
    <Picture
      src={imgSrcLandscape}
      formats={['avif', 'webp']}
      alt="An abstract image."
      loading="eager"
      class="w-full h-full object-cover opacity-70 hidden lg:block"
    />
  </div>

  <!-- frosted overlay -->
  <div class="absolute inset-0 z-0 bg-white/30"></div>

  <!-- top fade -->
  <div
    class="absolute inset-x-0 top-0 h-32 bg-gradient-to-b from-black/60 z-10 filter blur-lg"
  >
  </div>

  <!-- Foreground content -->
  <div
    class="relative z-10 w-full max-w-md sm:max-w-2xl mx-auto drop-shadow-xl/50"
  >
    <slot />
  </div>
</main>
