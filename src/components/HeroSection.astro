---
import Picture from 'astro/components/Picture.astro'
import { Image } from 'astro:assets'

const {
  id,
  background = 'bg-black',
  imgSrcPortrait,
  imgSrcLandscape,
  bottomFadeColour,
} = Astro.props
---

<main
  id={id}
  class="min-h-screen flex items-center justify-center px-4 sm:px-6 bg-text-bg-1"
>
  <!-- Background Image -->

  <div class="absolute inset-0 z-0">
    <!-- Mobile (portrait) -->

    <Picture
      src={imgSrcPortrait}
      formats={['avif', 'webp']}
      alt="An abstract image."
      loading="eager"
      class="w-full h-full object-cover block lg:hidden"
    />

    <!-- Desktop (landscape) -->
    <Picture
      src={imgSrcLandscape}
      formats={['avif', 'webp']}
      alt="An abstract image."
      loading="eager"
      class="w-full h-full object-cover hidden lg:block"
    />
  </div>

  <!-- dark overlay -->
  <!-- <div class="absolute inset-0 z-0 bg-black/30"></div> -->

  <!-- bottom fade -->
  <!-- <div class="lg:hidden">
    <div
      class="absolute bottom-0 left-0 w-full h-32 bg-gradient-to-b from transparent to-text-bg-1 z-10"
    >
    </div>
  </div> -->

  <!-- Foreground content -->
  <div
    class="relative z-10 w-full max-w-md sm:max-w-2xl mx-auto drop-shadow-xl/50"
  >
    <slot />
  </div>
</main>
