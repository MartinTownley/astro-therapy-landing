---
import { Image } from 'astro:assets'

const {
  id,
  background = 'bg-black',
  imgSrcPortrait,
  imgSrcLandscape,
  heading,
  subheading,
  button,
} = Astro.props
---

<main class="relative min-h-screen bg-text-bg-1">
  <!-- Background Image -->
  <div class="absolute inset-0 z-0 overflow-hidden">
    <!-- Mobile (portrait) -->
    <Image
      src={imgSrcPortrait}
      alt="An abstract image."
      loading="eager"
      layout="full-width"
      class="w-full h-full object-cover block lg:hidden blur-[1px] hero-bg-image"
    />

    <!-- Desktop (landscape) -->
    <Image
      src={imgSrcLandscape}
      alt="An abstract image."
      loading="eager"
      layout="full-width"
      class="w-full h-full object-cover hidden lg:block blur-[1px] hero-bg-image"
    />
  </div>

  <!-- Overlay -->
  <div class="absolute inset-0 bg-black/40"></div>

  <!-- Content Grid -->
  <div
    class="relative z-10 container mx-auto px-4 h-full grid grid-cols-12 items-center"
  >
    <!-- Content -->
    <div
      class="col-span-12 md:col-span-8 lg:col-span-10 lg:col-start-2 md:col-start-1 space-y-8 md:translate-y-20 text-center md:text-left flex flex-col items-center md:items-start text-text-bg-1 [text-shadow:0_4px_8px_rgba(0,0,0,0.7)]"
    >
      <h1
        class="hero-animate text-4xl sm:text-5xl lg:text-6xl font-bold leading-tight"
        style="animation-delay: 0ms"
      >
        {heading}
      </h1>
      <div class="hero-animate" style="animation-delay: 200ms">
        <p
          class="text-lg sm:text-xl lg:text-2xl font-light leading-relaxed max-w-xs sm:max-w-md lg:max-w-lg"
        >
          {subheading}
        </p>
      </div>
      <a href="#contact" class="hero-animate" style="animation-delay: 400ms">
        <button
          class="hero-cta relative text-white font-medium text-lg sm:text-xl lg:text-2xl cursor-pointer rounded-xl border-2 border-white/60 px-6 py-2 bg-black/20 lg:rounded-none lg:border-0 lg:px-0 lg:py-0 lg:bg-transparent after:content-[''] after:absolute after:bottom-0 after:left-0 after:h-px after:w-0 after:bg-white after:transition-all after:duration-300 hover:after:w-full"
        >
          {button}
        </button>
      </a>
    </div>
    <!-- <a
href="#about"
class="absolute bottom-6 left-1/2 -translate-x-1/2 z-20 cursor-pointer"
>
<ArrowDownIcon
className="h-12 md:h-16 w-12 md:w-16 text-white opacity-80 hover:opacity-100"
/>
</a> -->
  </div>
</main>

<style>
  @media (max-width: 1023px) {
    .hero-cta {
      -webkit-backdrop-filter: blur(16px);
      backdrop-filter: blur(16px);
    }
    .hero-cta::after {
      display: none;
    }
  }
</style>
