---
import { Image } from "astro:assets";
import bgImg from "../assets/hero-bg.png";
import HeroCard from "./HeroCard.astro";
---

<main class="min-h-screen flex items-center justify-center px-4 py-16 sm:px-6 bg-black">
    <!-- <slot/> -->
    <!-- <img src={bgImg.src} /> -->
     <!-- Background Image -->
    <div class="absolute inset-0 z-0">

    <Image src={bgImg} alt="" loading="eager" quality={"max"} class="w-full h-full object-cover opacity-80"/>
    </div>
    

    <!-- Foreground content -->
     <div class="relative z-10 w-full">
        <HeroCard />
     </div>

</main>