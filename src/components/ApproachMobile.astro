---
import { Image } from 'astro:assets'
const { id, approachText, profileImgSrc } = Astro.props
---

<section id={id} class="bg-theme-green">
  <!-- Profile image - full bleed -->
  <div class="fade-up w-full">
    <Image
      src={profileImgSrc}
      alt="Photo of Jade Zelkowicz."
      loading="eager"
      layout="full-width"
      class="w-full object-cover max-h-96"
    />
  </div>

  <!-- Green panel rising over image -->
  <div
    class="relative z-10 -mt-12 bg-theme-green rounded-t-3xl px-6 pt-8 pb-12 space-y-4"
  >
    <h2
      class="fade-up text-2xl font-semibold bg-main-beige text-theme-green-dark block w-fit mx-auto px-4 py-1 border-b-2 border-r-2 border-black"
    >
      {approachText.heading}
    </h2>
    <div class="space-y-4">
      {
        approachText.paras.map((para: string, i: number) => (
          <p
            class="fade-up leading-relaxed text-lg text-white"
            style={`transition-delay: ${(i + 1) * 100}ms`}
          >
            {para}
          </p>
        ))
      }
    </div>
  </div>
</section>
