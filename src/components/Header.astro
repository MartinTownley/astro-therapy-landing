---
import '../styles/global.css'
const { bgColour } = Astro.props
---

<!-- bg-[var(--color-header)] -->
<header
  class={`relative h-16 w-full md:h-20 rounded-sm top-0 z-50 flex justify-start items-center px-4 md:px-6 max-w-screen mx-auto ${bgColour} backdrop-blur-sm`}
>
  <a href="/" class="flex items-center gap-x-4">
    <p
      class="uppercase text-xl max-sm:text-lg text-[#f5f5f5] drop-shadow-sm font-semibold"
    >
      jade zelkowicz
    </p>
  </a>
</header>
