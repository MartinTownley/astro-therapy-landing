---
const { text } = Astro.props
---

<section
  class="noise relative hidden lg:block bg-theme-green-dark text-white py-20 px-20"
>
  <div class="max-w-5xl mx-auto">
    <!-- Heading -->
    <h2
      class="fade-up inline-block bg-main-beige text-theme-green-dark text-3xl font-semibold px-6 py-2 mb-10 border-black border-b-2 border-r-2"
    >
      {text.heading}
    </h2>

    <!-- Intro paragraph -->
    <!-- <p
      class="fade-up text-xl leading-relaxed mb-10 opacity-90"
      style="transition-delay: 100ms"
    >
      {text.paras[0]}
    </p> -->

    <!-- Points grid -->
    <div class="grid grid-cols-2 gap-6">
      {
        text.points.map(
          (point: { label: string; description: string }, i: number) => (
            <div
              class="fade-up border-white/30 py-1"
              style={`transition-delay: ${(i + 2) * 100}ms`}
            >
              <h3 class="text-xs font-semibold tracking-widest uppercase text-theme-pink mb-2">
                {point.label}
              </h3>
              <p class="text-lg leading-relaxed opacity-90">
                {point.description}
              </p>
            </div>
          ),
        )
      }
    </div>
  </div>
</section>
