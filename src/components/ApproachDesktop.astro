---
import { Image } from 'astro:assets'
import { approachText } from '../content/textContent'
const { id, profileImgSrc, heading } = Astro.props
---

<section id={id} class="bg-theme-green px-10 py-16 lg:px-40 lg:py-24">
  <div class="max-w-5xl mx-auto flex flex-row items-center">
    <div
      class="fade-up w-1/2 aspect-square rounded-3xl overflow-hidden shadow-[0_8px_24px_rgba(0,0,0,0.25)]"
    >
      <Image
        src={profileImgSrc}
        alt="Photo of Jade Zelkowicz."
        loading="lazy"
        layout="full-width"
        class="w-full h-full object-cover"
      />
    </div>

    <div class="w-1/2 flex flex-col justify-center">
      <!-- Heading & Paragraph Container -->
      <div class="px-6">
        <!-- Heading -->
        <h2
          class="fade-up block w-fit bg-main-beige px-3 py-1 text-3xl font-semibold tracking-tight text-theme-green-dark border-b-2 border-r-2 border-black mb-3"
        >
          {heading}
        </h2>
        <!-- Paragraphs -->
        <div class="space-y-4">
          {
            approachText.paras.map((para: string, i: number) => (
              <p
                class="fade-up text-xl leading-relaxed max-w-prose text-white"
                style={`transition-delay: ${(i + 1) * 100}ms`}
              >
                {para}
              </p>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
