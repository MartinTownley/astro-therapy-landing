---
const {heading, email, phone} = Astro.props;
---

<section class="flex flex-col items-center bg-[var(--color-text-bg-2)] py-10 px-6 text-center max-w-full sm:max-w-md mx-auto text-[var(--color-hero-text)] space-y-4 border border-[var(--color-outline)]">
    <h1 class="text-3xl font-bold">{heading}</h1>
    <p>
        <span class="font-semibold">{email.label}</span> {email.value}
      </p>
      <p>
        <span class="font-semibold">{phone.label}</span> {phone.value}
      </p>
</section>
