---
import { Image } from 'astro:assets'
const { id, heading, paras, imgSrc, imgAlt, imageLeft = true } = Astro.props
---

<section id={id} class="relative min-h-0 flex justify-center w-full py-0">
  <div
    class={`flex  items-stretch gap-8 px-0 bg-text-bg-1 ${imageLeft ? '' : 'flex-row-reverse'}`}
  >
    <div class="relative w-1/2 block">
      <Image
        src={imgSrc}
        alt={imgAlt}
        loading="lazy"
        class="absolute w-full h-full object-cover"
      />

      <!-- Dark Overlay -->
      <div class="absolute inset-0 bg-black/30"></div>

      <h2
        class="absolute left-1/2 top-1/2 transform -translate-x-1/2 -translate-y-1/2 text-4xl font-semibold text-white text-center z-10 border-b-8 border-white pb-6 backdrop-blur-md px-2 py-2 rounded-md"
      >
        {heading}
      </h2>
    </div>

    <div class="w-1/2 px-6 py-12 mx-auto flex flex-col items-start text-black">
      <div class="space-y-0">
        {
          paras.map((para: string) => (
            <p class="text-xl text-black mt-0 py-3 leading-relaxed text-left">
              {para}
            </p>
          ))
        }
      </div>
    </div>
  </div>
</section>
