---
import '../styles/global.css'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import ukcpLogoWhiteBG from '../assets/ukcp_master_logo.png'
import ukcpLogoTransBG from '../assets/UKCP-black-trans.png'
import '@fontsource/poppins'
import '@fontsource/poppins/100'
import '@fontsource/poppins/200'
import '@fontsource/poppins/300'
import '@fontsource/poppins/400'
import '@fontsource/poppins/500'
import '@fontsource/poppins/600'
import '@fontsource/poppins/700'
import '@fontsource/poppins/800'

interface Props {
  title: string
  description?: string
  image?: string
}
const { title, description = 'Psychotherapy website' } = Astro.props
---

<!-- Layout.astro --><!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <!-- <link rel="icon" type="image/svg+xml" href="/favicon.svg" /> -->
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body class="">
    <Header />
    <!-- <div class="max-w-screen-xl mx-auto"> -->
    <main class="flex flex-col">
      <slot />
    </main>

    <Footer logoSrc={ukcpLogoTransBG} logoAlt="UKCP Logo" />
    <!-- </div> -->
  </body>
</html>
