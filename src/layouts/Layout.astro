---
//layout.astro
import '../styles/global.css'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import ukcpLogoWhiteBG from '../assets/ukcp_master_logo.png'
import ukcpLogoTransBG from '../assets/UKCP-black-trans.png'
import DebugGrid from '../components/DebugGrid.astro'
import '@fontsource/poppins'
import '@fontsource/poppins/100'
import '@fontsource/poppins/200'
import '@fontsource/poppins/300'
import '@fontsource/poppins/400'
import '@fontsource/poppins/500'
import '@fontsource/poppins/600'
import '@fontsource/poppins/700'
import '@fontsource/poppins/800'
import '@fontsource/merriweather/400'
import SideNav from '../components/SideNav.tsx'
import { Toaster } from 'sonner'

interface Props {
  title: string
  description?: string
  image?: string
}
const { title, description = 'Psychotherapy website' } = Astro.props
const dev = import.meta.env.DEV
---

<!-- Layout.astro --><!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <!-- <link rel="icon" type="image/svg+xml" href="/favicon.svg" /> -->
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body class="h-screen flex flex-col">
    <!-- <Header bgColour="bg-theme-green" /> -->

    <SideNav client:load />

    <main class="flex-grow flex flex-col">
      <slot />
    </main>

    <div class="bg-theme-pink/50">
      <hr class="border-t-1 border-gray-400 opacity-60 w-8/9 mx-auto" />
    </div>
    <Footer logoSrc={ukcpLogoTransBG} logoAlt="UKCP Logo" />

    <!-- {dev && <DebugGrid cols={12} gap={6} />} -->
    <Toaster
      client:load
      toastOptions={{ duration: 5000 }}
      position="bottom-center"
      richColors
    />
  </body>
</html>

{
  dev && (
    <script
      set:html={`
    window.addEventListener('load', () => {
      window.scrollTo(0, document.body.scrollHeight)
    });
  `}
    />
  )
}

