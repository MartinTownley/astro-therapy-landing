---
import '../styles/global.css'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import ukcpLogoWhiteBG from '../assets/ukcp_master_logo.png'
import ukcpLogoTransBG from '../assets/UKCP-black-trans.png'
import DebugGrid from '../components/DebugGrid.astro'
import '@fontsource/poppins'
import '@fontsource/poppins/100'
import '@fontsource/poppins/200'
import '@fontsource/poppins/300'
import '@fontsource/poppins/400'
import '@fontsource/poppins/500'
import '@fontsource/poppins/600'
import '@fontsource/poppins/700'
import '@fontsource/poppins/800'
import '@fontsource/merriweather/400'
import SideNav from '../components/SideNav.tsx'
import { PUBLIC_TEST } from 'astro:env/client'

interface Props {
  title: string
  description?: string
  image?: string
}
const { title, description = 'Psychotherapy website' } = Astro.props
const dev = import.meta.env.DEV
---

<!-- Layout.astro --><!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <!-- <link rel="icon" type="image/svg+xml" href="/favicon.svg" /> -->
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body class="h-screen flex flex-col">
    <!-- <Header bgColour="bg-theme-green" /> -->

    <SideNav client:load />

    <main class="flex-grow flex flex-col">
      <slot />
    </main>

    <!-- <div class="-mt-24 bg-red-500 min-h-24 w-full z-50">
      <p class="text-white text-center py-4">Hello</p>
    </div> -->
    <h1>{PUBLIC_TEST}</h1>
    <Footer logoSrc={ukcpLogoTransBG} logoAlt="UKCP Logo" />

    <!-- {dev && <DebugGrid cols={12} gap={6} />} -->
  </body>

  <!-- <script>
    const publicAnybody = import.meta.env.PUBLIC_ANYBODY
    const secretPassword = import.meta.env.SECRET_PASSWORD
    console.log(' ~ pub:', publicAnybody)
    console.log(' ~ sec:', secretPassword)
  </script> -->
</html>

<script>
  window.addEventListener('load', () => {
    window.scrollTo(0, document.body.scrollHeight)
  })
</script>
