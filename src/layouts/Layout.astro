---
import '../styles/global.css'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import ukcpLogoWhiteBG from '../assets/ukcp_master_logo.png'
import ukcpLogoTransBG from '../assets/UKCP-black-trans.png'
interface Props {
  title: string
  description?: string
  image?: string
}
const { title, description = 'Psychotherapy website' } = Astro.props
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <!-- <link rel="icon" type="image/svg+xml" href="/favicon.svg" /> -->
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body class="min-h-screen">
    <Header />
    <main class="">
      <slot />
    </main>
    <Footer logoSrc={ukcpLogoTransBG} logoAlt="UKCP Logo" />
  </body>
</html>
